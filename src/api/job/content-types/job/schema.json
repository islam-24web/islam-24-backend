{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Job",
    "description": "Aggregated job postings with halal filtering and bilingual i18n"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "descriptionShort": {
      "type": "text",
      "maxLength": 200,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "metaDescription": {
      "type": "string",
      "maxLength": 160,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "externalId": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sourceUrl": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "applyUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "referralTag": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "datePosted": {
      "type": "datetime",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "validThrough": {
      "type": "datetime",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "employmentType": {
      "type": "enumeration",
      "enum": [
        "FULL_TIME",
        "PART_TIME",
        "CONTRACTOR",
        "TEMPORARY",
        "INTERN",
        "VOLUNTEER",
        "PER_DIEM",
        "OTHER"
      ],
      "default": "FULL_TIME",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "jobLocationType": {
      "type": "enumeration",
      "enum": ["TELECOMMUTE", "ONSITE", "HYBRID"],
      "default": "TELECOMMUTE",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "applicantLocationRequirements": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "physicalLocation": {
      "type": "component",
      "component": "shared.physical-location",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "salaryMin": {
      "type": "decimal",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "salaryMax": {
      "type": "decimal",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "salaryCurrency": {
      "type": "string",
      "default": "USD",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "salaryUnit": {
      "type": "enumeration",
      "enum": ["HOUR", "DAY", "WEEK", "MONTH", "YEAR"],
      "default": "YEAR",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "salaryUSDMin": {
      "type": "decimal",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "salaryUSDMax": {
      "type": "decimal",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "tags": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "jobs"
    },
    "jobCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::job-category.job-category",
      "inversedBy": "jobs"
    },
    "source": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::source.source",
      "inversedBy": "jobs"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "expired",
        "rejected_halal",
        "rejected_quality",
        "draft"
      ],
      "default": "draft",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "halalScore": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "halalNotes": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "viewCount": {
      "type": "integer",
      "default": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
