{
  "kind": "singleType",
  "collectionName": "app_settings",
  "info": {
    "singularName": "app-setting",
    "pluralName": "app-settings",
    "displayName": "App Setting"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "appName": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "appVersion": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "welcomeMessage": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "openingVerse": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "openingRef": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "maintenanceMode": {
      "type": "boolean",
      "default": false,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "rankThresholds": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "pointsRules": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "supportedLanguages": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "quranApiBaseUrl": {
      "type": "string",
      "default": "https://api.quran.com/api/v4",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "competitionEnabled": {
      "type": "boolean",
      "default": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "notificationsConfig": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
