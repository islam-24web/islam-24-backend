{
  "kind": "collectionType",
  "collectionName": "job_categories",
  "info": {
    "singularName": "job-category",
    "pluralName": "job-categories",
    "displayName": "Job Category",
    "description": "Job taxonomy (separate from blog categories)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "icon": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "parentCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::job-category.job-category",
      "inversedBy": "subcategories"
    },
    "subcategories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job-category.job-category",
      "mappedBy": "parentCategory"
    },
    "jobs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job.job",
      "mappedBy": "jobCategory"
    }
  }
}
