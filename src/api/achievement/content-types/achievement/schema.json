{
  "kind": "collectionType",
  "collectionName": "achievements",
  "info": {
    "singularName": "achievement",
    "pluralName": "achievements",
    "displayName": "Achievement",
    "description": "Badges and milestones users can unlock"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "icon": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "tasbih",
        "prayer",
        "quran",
        "dhikr",
        "heart_deeds",
        "divine_names",
        "maqams",
        "streak",
        "rank",
        "social",
        "special"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "requiredCount": {
      "type": "integer",
      "default": 1,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "pointsReward": {
      "type": "integer",
      "default": 100,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "rarity": {
      "type": "enumeration",
      "enum": ["common", "rare", "epic", "legendary"],
      "default": "common",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isHidden": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
